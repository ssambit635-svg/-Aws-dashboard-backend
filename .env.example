# ── Application ────────────────────────────────────────────────────────────
DASH_ENVIRONMENT=local            # local | staging | production
DASH_DEBUG=false
DASH_LOG_LEVEL=INFO

# ── AWS ────────────────────────────────────────────────────────────────────
# auto = use boto3 when credentials resolve, otherwise fall back to the
#        deterministic demo provider (default; keeps the repo runnable anywhere)
# aws  = require real credentials, fail loudly if they are missing
# mock = always use the demo provider
DASH_PROVIDER_MODE=auto
DASH_AWS_REGION=us-east-1
DASH_COST_EXPLORER_REGION=us-east-1
# DASH_AWS_PROFILE=my-profile
DASH_AWS_TIMEOUT_SECONDS=10

# Credentials are read from the standard AWS chain (env vars, profile, IAM
# role). Never commit real keys — if you need to use static keys locally, put
# them here and make sure .env is git-ignored (it is).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── Security ───────────────────────────────────────────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASH_API_KEY=local-dev-key
DASH_AUTH_ENABLED=true
# Inject the dev key into the dashboard HTML so `make run` needs no setup.
# Ignored outside local/staging.
DASH_BOOTSTRAP_DASHBOARD=true

# ── Behaviour ──────────────────────────────────────────────────────────────
DASH_CACHE_TTL_SECONDS=60
DASH_MONTHLY_BUDGET=8000
DASH_COST_CURRENCY=USD
DASH_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
